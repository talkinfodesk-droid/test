{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "rootDir": "./src",
    "types": ["jest"],
    "paths": { "@/*": ["./src/*"] },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/__tests__/**/*.ts", "src/lib/**/*.ts"]
}
